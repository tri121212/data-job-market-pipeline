#!/bin/sh
# No-op Docker credential helper.
#
# Why: Docker Desktop's helper (docker-credential-desktop) needs the macOS
# Keychain, which is unavailable to processes spawned inside the app sandbox.
# Public registry pulls only need anonymous auth, so this helper simply
# returns an empty credential set.
#
# Do NOT use this for private registries that require a login.
case "$1" in
  get) echo '{"ServerURL":"","Username":"","Secret":""}' ;;
  store|erase) cat >/dev/null 2>&1 ;;
  list) echo '{}' ;;
  *) echo '{}' ;;
esac
